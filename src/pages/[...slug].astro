---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Page from "../layouts/Page.astro";

export async function getStaticPaths() {
  const savory = await getCollection("savory");
  const sweet = await getCollection("sweet");

  const paths: object[] = [];

  // Add paths for savory
  savory.forEach((recipe: any) => {
    const { slug } = recipe;
    paths.push({
      params: { slug },
      props: recipe,
    });
  });

  // Add paths for sweet
  sweet.forEach((recipe: any) => {
    const { slug } = recipe;
    paths.push({
      params: { slug },
      props: recipe,
    });
  });

  return paths;
}

type Props = CollectionEntry<"savory"> | CollectionEntry<"sweet">;

const post: Props = Astro.props;
const { Content } = await post.render();
---

<Page frontmatter={post.data}>
  <Content />
</Page>
