---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";
import LandingPageContainer from "../components/LandingPageContainer";
import Grid from "../components/Grid.astro";
import Card from "../components/Card.astro";

const savory = (await getCollection("savory")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Home</title>
  </head>
  <body class="bg-[#f8fafc] dark:bg-[#0f0f0f] text-black dark:text-white">
    <Header />
    <main class="max-w-[1200px] mx-auto">
      <div class="mt-12 mb-24 mx-4">
        <div class="my-8">
          <h1 class="text-4xl font-bold uppercase">Savory</h1>
          <p class="text-gray-600">Big flavors. Simple steps.</p>
          {
            /*<h1>BUILD</h1>
          <p>Start with a base, adjust to taste.</p>*/
          }
        </div>
        <div class="flex flex-col md:flex-row gap-4 bg-gray-100 p-4 rounded-lg">
          <Card item={savory[0]} featured={true} />
          <Grid items={savory} />
        </div>
      </div>
    </main>
    <Footer />
  </body>
  <script>
    // This script will run on the client side
    document.addEventListener("DOMContentLoaded", () => {
      const isDarkMode = localStorage.getItem("darkMode") === "true";
      if (isDarkMode) {
        document.documentElement.classList.add("dark");
      }
    });
  </script>
  <style>
    body {
      font-family: Helvetica, sans-serif;
    }
  </style>
</html>
