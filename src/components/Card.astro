---
interface Props {
  // Individual props (for backward compatibility)
  title?: string;
  description?: string;
  href?: string;
  img?: string;
  featured?: boolean;
  // OR a markdown file (content collection item)
  item?: {
    id: string;
    slug: string;
    data: {
      title: string;
      description: string;
      img?: string;
    };
  };
}

const { title, description, href, img, featured = false, item } = Astro.props;

// If item is provided, use its data; otherwise use individual props
const finalTitle = item ? item.data.title : title || "Featured Recipe";
const finalDescription = item
  ? item.data.description
  : description ||
    "Discover amazing flavors and cooking techniques that will transform your kitchen experience.";
const finalHref = item ? `/${item.slug}` : href || "#";
const finalImg = item ? item.data.img : img;
---

<a class="block w-full h-auto group" href={finalHref}>
  <div
    class="bg-white/70 backdrop-blur-md rounded-xl shadow-lg border border-white/20 hover:shadow-xl transition-all duration-300 hover:scale-[1.02] overflow-hidden h-full"
  >
    {
      finalImg && (
        <div class={`w-full overflow-hidden ${featured ? "h-fill" : "h-48"}`}>
          <img
            src={finalImg}
            alt={finalTitle}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
          />
        </div>
      )
    }
    <div class={`${featured ? "p-8" : "p-6"}`}>
      <h2
        class={`font-semibold text-gray-800 mb-3 group-hover:text-gray-900 transition-colors duration-200 ${featured ? "text-2xl" : "text-xl"}`}
      >
        {finalTitle}
      </h2>
      <p
        class={`text-gray-600 leading-relaxed group-hover:text-gray-700 transition-colors duration-200 ${featured ? "text-lg" : ""}`}
      >
        {finalDescription}
      </p>
    </div>
  </div>
</a>
